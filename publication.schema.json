{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reasoning Library publication manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "author",
    "canonical_url",
    "repository",
    "deployment",
    "checkout",
    "release",
    "description"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "kind": {
      "enum": [
        "book",
        "research_framework"
      ]
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "checkout": {
      "type": "object",
      "required": [
        "provider",
        "endpoint",
        "merchant",
        "product_id",
        "amount",
        "currency",
        "return_path",
        "cancel_path"
      ],
      "properties": {
        "provider": {
          "const": "paypal"
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "currency": {
          "const": "USD"
        }
      }
    },
    "deployment": {
      "type": "object",
      "required": [
        "provider",
        "project_id",
        "team_id",
        "status"
      ]
    }
  },
  "additionalProperties": true
}
