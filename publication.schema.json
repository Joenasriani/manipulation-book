{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reasoning Library public publication manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "author",
    "canonical_url",
    "repository",
    "deployment",
    "checkout",
    "release",
    "description"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "kind": {"enum": ["book", "research_framework"]},
    "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "checkout": {
      "type": "object",
      "required": ["provider", "mode", "endpoint", "hosted_url", "product_id", "amount", "currency"],
      "properties": {
        "provider": {"const": "paypal"},
        "mode": {"const": "hosted_button"},
        "endpoint": {"type": "string", "pattern": "^/api/"},
        "hosted_url": {"type": "string", "pattern": "^https://www\\.paypal\\.com/ncp/payment/"},
        "amount": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
        "currency": {"const": "USD"}
      }
    },
    "deployment": {
      "type": "object",
      "required": ["provider", "root_directory"],
      "properties": {
        "provider": {"const": "vercel"},
        "root_directory": {"const": "."}
      }
    }
  },
  "additionalProperties": true
}
